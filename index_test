<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Graham Baird — Senior Digital Designer specialising in UX, UI, content and service design.">
  <title>Graham Baird — Senior Digital Designer</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@500;600;700&display=swap" rel="stylesheet">

  <style>
    :root{
      --green:#155c48;
      --green-2:#0f4e3c;
      --green-pale:#eef5f1;
      --green-pale-2:#e6f0eb;
      --ink:#152321;
      --body:#53635f;
      --muted:#70807b;
      --line:#dce6e1;
      --white:#fff;
      --max:1100px;
      --display:"Plus Jakarta Sans",Inter,system-ui,sans-serif;
      --sans:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
    }

    *{box-sizing:border-box}
    html{scroll-behavior:smooth;scroll-padding-top:70px}
    body{
      margin:0;
      color:var(--ink);
      background:#fff;
      font-family:var(--sans);
      font-size:14px;
      line-height:1.55;
      -webkit-font-smoothing:antialiased;
    }
    img{max-width:100%;display:block}
    a{color:inherit}
    button,a{font:inherit}
    a:focus-visible,button:focus-visible{
      outline:3px solid #9bd3bd;
      outline-offset:4px;
      border-radius:4px;
    }

    .skip-link{
      position:fixed;
      top:-100px;
      left:14px;
      z-index:1000;
      padding:10px 14px;
      color:#fff;
      background:#10201c;
      text-decoration:none;
      font-weight:700;
      border-radius:0 0 6px 6px;
    }
    .skip-link:focus{top:0}

    .container{
      width:min(80.5%,824px);
      margin-inline:auto;
    }

    /* Header */
    .site-header{
      position:sticky;
      top:0;
      z-index:100;
      height:39px;
      background:rgba(255,255,255,.94);
      backdrop-filter:blur(12px);
      border-bottom:1px solid rgba(220,230,225,.25);
    }
    .nav{
      height:39px;
      display:flex;
      align-items:center;
      justify-content:space-between;
    }
    .brand{
      font-family:var(--display);
      font-size:13px;
      font-weight:700;
      letter-spacing:-.03em;
      text-decoration:none;
    }
    .nav-links{
      display:flex;
      align-items:center;
      gap:24px;
      list-style:none;
      padding:0;
      margin:0;
    }
    .nav-links a{
      font-size:7px;
      line-height:1;
      font-weight:700;
      letter-spacing:.08em;
      text-transform:uppercase;
      text-decoration:none;
      color:#25322f;
    }
    .nav-links a:hover{color:var(--green)}
    .menu-button{
      display:none;
      width:38px;
      height:38px;
      padding:0;
      border:1px solid var(--line);
      background:#fff;
      border-radius:7px;
      cursor:pointer;
    }
    .menu-button span,
    .menu-button::before,
    .menu-button::after{
      content:"";
      display:block;
      width:17px;
      height:1.5px;
      margin:4px auto;
      background:var(--ink);
    }

    /* Hero */
    .hero{
      position:relative;
      overflow:hidden;
      background:
        radial-gradient(ellipse at 76% 56%,rgba(202,224,214,.62) 0 23%,transparent 24%),
        linear-gradient(120deg,#fff 0 52%,#f1f7f4 52% 100%);
    }
    .hero::after{
      content:"";
      position:absolute;
      width:520px;
      height:520px;
      right:-230px;
      top:-190px;
      border-radius:50%;
      border:82px solid rgba(213,232,224,.6);
      pointer-events:none;
    }
    .hero-grid{
      position:relative;
      z-index:1;
      height:328px;
      display:grid;
      grid-template-columns:1fr 1.12fr;
      gap:32px;
      align-items:center;
    }
    .eyebrow{
      display:inline-flex;
      padding:6px 11px;
      border-radius:999px;
      background:#e6f0eb;
      color:var(--green);
      font-size:7px;
      font-weight:800;
      letter-spacing:.14em;
      text-transform:uppercase;
    }
    h1,h2,h3{
      font-family:var(--display);
      letter-spacing:-.04em;
      margin:0;
    }
    .hero h1{
      max-width:430px;
      margin:14px 0 13px;
      font-size:42px;
      line-height:1.03;
      font-weight:600;
    }
    .hero h1 em{
      color:var(--green);
      font-style:normal;
    }
    .hero-copy{
      max-width:370px;
      margin:0 0 9px;
      color:#455651;
      font-size:10px;
      line-height:1.48;
    }
    .hero-actions{
      display:flex;
      gap:9px;
      margin-top:13px;
      flex-wrap:wrap;
    }
    .button{
      min-height:29px;
      display:inline-flex;
      align-items:center;
      gap:7px;
      padding:0 14px;
      border-radius:999px;
      font-size:8px;
      font-weight:700;
      text-decoration:none;
      transition:transform .2s,background .2s,border-color .2s;
    }
    .button:hover{transform:translateY(-1px)}
    .button-primary{color:#fff;background:var(--green)}
    .button-primary:hover{background:var(--green-2)}
    .button-secondary{
      color:var(--green);
      background:#fff;
      border:1px solid #7da99a;
    }
    .disciplines{
      display:flex;
      gap:11px;
      margin-top:15px;
      color:#61726c;
      font-size:6px;
      font-weight:700;
      letter-spacing:.17em;
      text-transform:uppercase;
    }
    .disciplines span+span::before{
      content:"·";
      margin-right:11px;
      color:#9baca6;
    }

    /* Hero visual — deliberately built in HTML/CSS so it remains editable */
    .hero-art{
      position:relative;
      height:300px;
      display:flex;
      align-items:center;
      justify-content:center;
    }
    .laptop{
      width:430px;
      position:relative;
      transform:translate(20px,4px);
      filter:drop-shadow(0 17px 19px rgba(16,48,39,.18));
    }
    .laptop-screen{
      aspect-ratio:16/10;
      padding:7px;
      background:#171b1a;
      border-radius:8px 8px 5px 5px;
    }
    .screen-inner{
      height:100%;
      overflow:hidden;
      background:#fff;
      border-radius:2px;
    }
    .browser{
      height:22px;
      display:flex;
      align-items:center;
      gap:4px;
      padding:0 7px;
      border-bottom:1px solid #e3e8e6;
      background:#f8faf9;
    }
    .browser i{
      width:5px;height:5px;border-radius:50%;background:#a5b2ad;
    }
    .mock-browser-content{
      padding:17px 25px;
    }
    .mock-logo{
      font-size:5px;
      color:#596863;
      font-weight:700;
    }
    .mock-search{
      height:13px;
      width:58%;
      margin:9px 0 14px;
      border:1px solid #e1e7e4;
      border-radius:2px;
    }
    .mock-heading{
      width:54%;
      font:700 17px/1 var(--display);
      letter-spacing:-.05em;
      margin-bottom:7px;
    }
    .mock-sub{
      width:55%;
      color:#6d7b76;
      font-size:6px;
      line-height:1.45;
    }
    .mock-field{
      width:69%;
      height:20px;
      margin-top:10px;
      border:1px solid #cfd9d5;
      border-radius:2px;
      position:relative;
    }
    .mock-field::after{
      content:"Search";
      position:absolute;
      right:-1px;
      top:-1px;
      height:20px;
      padding:0 10px;
      display:flex;
      align-items:center;
      color:#fff;
      background:var(--green);
      font-size:5px;
      font-weight:700;
      border-radius:0 2px 2px 0;
    }
    .mock-popular{
      margin-top:12px;
      font-size:5px;
      color:#65746f;
    }
    .mock-popular strong{display:block;margin-bottom:5px;color:#4a5954}
    .mock-popular span{
      display:inline-block;
      margin-right:9px;
      color:#4d9277;
      font-size:5px;
    }
    .laptop-base{
      width:106%;
      height:9px;
      margin-left:-3%;
      background:linear-gradient(#aeb8b4,#7d8985);
      border-radius:0 0 10px 10px;
    }
    .phone{
      position:absolute;
      right:0%;
      bottom:14px;
      width:92px;
      padding:5px;
      background:#171b1a;
      border-radius:15px;
      filter:drop-shadow(0 14px 15px rgba(16,48,39,.2));
    }
    .phone-screen{
      aspect-ratio:9/18;
      overflow:hidden;
      padding:12px 8px;
      background:#fff;
      border-radius:10px;
    }
    .phone-top{
      display:flex;
      justify-content:space-between;
      color:#68756f;
      font-size:6px;
    }
    .phone-title{
      margin-top:25px;
      font:700 13px/1.02 var(--display);
      letter-spacing:-.05em;
    }
    .phone-copy{
      margin-top:6px;
      color:#68756f;
      font-size:5px;
      line-height:1.4;
    }
    .phone-button{
      margin-top:7px;
      width:48px;
      height:14px;
      display:grid;
      place-items:center;
      color:#fff;
      background:#6745e5;
      border-radius:3px;
      font-size:5px;
      font-weight:700;
    }
    .phone-card{
      height:58px;
      margin-top:11px;
      border-radius:6px;
      background:linear-gradient(135deg,#d9d2ff,#f2efff);
      position:relative;
    }
    .phone-card::after{
      content:"";
      position:absolute;
      width:31px;height:42px;
      right:14px;bottom:0;
      border-radius:7px 7px 0 0;
      background:linear-gradient(160deg,#8d75ee,#5140b9);
    }

    /* Trust */
    .trust{
      background:#edf5f1;
      border-bottom:1px solid #e2ebe7;
    }
    .trust-grid{
      height:66px;
      display:grid;
      grid-template-columns:105px repeat(6,1fr);
      align-items:center;
      gap:16px;
    }
    .trust-label{
      color:var(--green);
      font-size:7px;
      font-weight:800;
      letter-spacing:.14em;
      text-transform:uppercase;
    }
    .client{
      height:38px;
      padding-left:14px;
      border-left:1px solid #9eafa9;
      display:flex;
      align-items:center;
      justify-content:center;
    }
    .client img{
      width:100%;
      max-width:115px;
      height:38px;
      object-fit:contain;
      filter:grayscale(100%);
      opacity:.78;
    }

    /* General sections */
    section{scroll-margin-top:70px}
    .section{
      padding:22px 0;
    }
    .section-label{
      display:block;
      margin-bottom:8px;
      color:var(--green);
      font-size:7px;
      font-weight:800;
      letter-spacing:.15em;
      text-transform:uppercase;
    }

    /* Selected work — one horizontal row on desktop */
    .work-head{
      display:flex;
      justify-content:space-between;
      align-items:end;
      gap:25px;
      margin-bottom:17px;
    }
    .work-head h2{
      max-width:570px;
      color:#103f35;
      font-size:18px;
      line-height:1.15;
      font-weight:600;
    }
    .small-link{
      color:var(--green);
      font-size:7px;
      font-weight:700;
      text-decoration:underline;
      text-underline-offset:3px;
      white-space:nowrap;
    }
    .work-grid{
      display:grid;
      grid-template-columns:repeat(4,minmax(0,1fr));
      gap:14px;
      align-items:stretch;
      grid-auto-flow:column;
      grid-auto-columns:minmax(0,1fr);
    }
    .work-card{
      min-width:0;
      border:1px solid #dfe7e3;
      border-radius:3px;
      background:#fff;
      overflow:hidden;
      box-shadow:0 1px 3px rgba(18,47,38,.025);
      transition:transform .2s,box-shadow .2s;
    }
    .work-card:hover{
      transform:translateY(-2px);
      box-shadow:0 8px 20px rgba(18,47,38,.08);
    }
    .work-image{
      height:97px;
      overflow:hidden;
      background:#e7eeeb;
    }
    .work-image img{
      width:100%;
      height:100%;
      object-fit:cover;
      object-position:center;
    }
    .work-image.moj{background:#d9e5df}
    .work-image.three{background:#5b3ce1}
    .work-image.uog{background:#0b507c}
    .work-image.hilton{background:#b8b9ba}
    .work-body{
      height:166px;
      padding:9px 11px 10px;
      display:flex;
      flex-direction:column;
    }
    .work-client{
      margin-bottom:4px;
      font-size:8px;
      font-weight:700;
      color:#182320;
    }
    .work-title{
      margin-bottom:7px;
      font-size:7.5px;
      line-height:1.38;
      font-weight:600;
    }
    .work-desc{
      color:#5b6964;
      font-size:6px;
      line-height:1.45;
    }
    .work-tags{
      margin-top:auto;
      padding-top:8px;
      color:#75827e;
      font-size:6px;
      line-height:1.4;
    }
    .work-cta{
      margin-top:8px;
      color:var(--green);
      font-size:6.2px;
      font-weight:700;
      text-decoration:underline;
      text-underline-offset:2px;
    }

    /* What I do — one horizontal row on desktop */
    .services-section{
      background:#eef5f1;
      height:175px;
      padding:22px 0;
    }
    .services-grid{
      display:grid;
      grid-template-columns:minmax(0,1.12fr) repeat(5,minmax(0,1fr));
      gap:18px;
      align-items:start;
      grid-auto-flow:column;
      grid-auto-columns:minmax(0,1fr);
    }
    .services-intro h2{
      color:#103f35;
      max-width:210px;
      font-size:18px;
      line-height:1.1;
      font-weight:600;
    }
    .services-intro p{
      max-width:205px;
      margin:11px 0 0;
      color:#5a6a64;
      font-size:6px;
      line-height:1.55;
    }
    .service{
      min-width:0;
    }
    .service-icon{
      width:27px;height:27px;
      display:grid;
      place-items:center;
      margin-bottom:8px;
      border-radius:50%;
      background:#e0eee8;
      color:var(--green);
    }
    .service-icon svg{width:13px;height:13px}
    .service h3{
      margin-bottom:5px;
      color:#183b33;
      font-size:7px;
      line-height:1.25;
      letter-spacing:-.025em;
    }
    .service p{
      margin:0;
      color:#5d6d67;
      font-size:6.2px;
      line-height:1.5;
    }

    /* Approach */
    #approach{height:138px;}
    .approach-grid{
      display:grid;
      grid-template-columns:1.15fr 2.4fr;
      gap:38px;
      align-items:start;
    }
    .approach-title h2{
      color:#103f35;
      font-size:18px;
      line-height:1.1;
      font-weight:600;
    }
    .steps{
      display:grid;
      grid-template-columns:repeat(3,1fr);
      gap:21px;
    }
    .step{
      min-width:0;
    }
    .step-number{
      width:25px;height:25px;
      display:grid;
      place-items:center;
      margin-bottom:8px;
      border-radius:50%;
      background:#edf4f1;
      color:var(--green);
      font-size:7px;
      font-weight:800;
    }
    .step h3{
      margin-bottom:5px;
      color:#183b33;
      font-size:8px;
      line-height:1.2;
    }
    .step p{
      margin:0;
      color:#5c6c66;
      font-size:6.2px;
      line-height:1.5;
    }

    /* Why work with me — one horizontal row on desktop */
    .experience{
      background:#eef5f1;
      height:138px;
      padding:20px 0;
    }
    .experience-grid{
      display:grid;
      grid-template-columns:minmax(0,1.2fr) repeat(4,minmax(0,1fr));
      gap:19px;
      align-items:start;
      grid-auto-flow:column;
      grid-auto-columns:minmax(0,1fr);
    }
    .experience-intro h2{
      color:#103f35;
      max-width:225px;
      font-size:19px;
      line-height:1.1;
      font-weight:600;
    }
    .experience-intro p{
      max-width:230px;
      margin:10px 0 0;
      color:#5c6c66;
      font-size:6px;
      line-height:1.45;
    }
    .stat{
      padding-left:15px;
      border-left:1px solid #d5e1dc;
    }
    .stat-icon{
      width:27px;height:27px;
      display:grid;
      place-items:center;
      margin-bottom:7px;
      border-radius:50%;
      background:#e0eee8;
      color:var(--green);
    }
    .stat-icon svg{width:12px;height:12px}
    .stat strong{
      display:block;
      margin-bottom:3px;
      color:#153c32;
      font-size:7px;
      line-height:1.25;
      font-weight:700;
    }
    .stat span{
      display:block;
      color:#61716b;
      font-size:6.2px;
      line-height:1.45;
    }

    /* About */
    .about{
      height:146px;
      padding-top:16px;
      padding-bottom:16px;
    }
    .about-grid{
      display:grid;
      grid-template-columns:145px 1fr 1fr;
      gap:24px;
      align-items:start;
    }
    .portrait{
      width:145px;
      height:114px;
      border-radius:4px;
      overflow:hidden;
      background:#dbe5e0;
    }
    .portrait img{
      width:100%;
      height:100%;
      object-fit:cover;
      object-position:center;
    }
    .about-copy h2{
      color:#103f35;
      font-size:18px;
      line-height:1.05;
      font-weight:600;
      margin-bottom:8px;
    }
    .about-copy p{
      margin:0 0 8px;
      color:#5b6b65;
      font-size:6px;
      line-height:1.45;
    }
    .about-copy strong{
      color:#174b3d;
      font-weight:700;
    }

    /* Contact */
    .contact{
      height:88px;
      padding:16px 0;
      background:#0e5a47;
      color:#fff;
      position:relative;
      overflow:hidden;
    }
    .contact::before{
      content:"";
      position:absolute;
      width:250px;height:250px;
      left:-85px;top:-110px;
      border-radius:50%;
      border:50px solid rgba(255,255,255,.035);
    }
    .contact-grid{
      position:relative;
      z-index:1;
      display:grid;
      grid-template-columns:1fr 1.35fr auto;
      gap:31px;
      align-items:center;
    }
    .contact .section-label{
      color:#c4e0d5;
      margin-bottom:8px;
    }
    .contact h2{
      color:#fff;
      font-size:18px;
      line-height:1.05;
      font-weight:600;
    }
    .contact p{
      margin:0;
      color:rgba(255,255,255,.82);
      font-size:6px;
      line-height:1.45;
    }
    .contact p+p{margin-top:6px}
    .contact-actions{
      display:flex;
      flex-direction:column;
      align-items:flex-start;
      gap:8px;
    }
    .contact .button-primary{
      color:#164a3d;
      background:#fff;
    }
    .contact .button-secondary{
      border-color:rgba(255,255,255,.35);
      color:#fff;
      background:transparent;
    }
    .socials{
      display:flex;
      gap:13px;
      margin-top:5px;
    }
    .socials a{
      color:#fff;
      font-size:9px;
      text-decoration:none;
    }

    footer{
      background:#0b4b3b;
      color:rgba(255,255,255,.65);
      padding:5px 0;
      font-size:6px;
    }
    .footer-inner{
      display:flex;
      justify-content:space-between;
      gap:20px;
    }

    /* Motion */
    .reveal{
      opacity:0;
      transform:translateY(10px);
      transition:opacity .55s ease,transform .55s ease;
    }
    .reveal.is-visible{opacity:1;transform:none}
    @media (prefers-reduced-motion:reduce){
      html{scroll-behavior:auto}
      .reveal{opacity:1;transform:none;transition:none}
      *,*::before,*::after{animation-duration:.01ms!important;transition-duration:.01ms!important}
    }

    /* Responsive */
    
    @media (max-width:900px){
      .container{width:min(90%,var(--max))}
      .site-header,.nav{height:54px}
      .hero-grid{height:auto;min-height:auto;grid-template-columns:1fr;padding:45px 0 38px}
      .hero h1{font-size:clamp(34px,7vw,48px)}
      .services-section,#approach,.experience,.about,.contact{height:auto}
      .services-section,.experience{padding:30px 0}
      .about{padding:30px 0}
      .contact{padding:28px 0}

      .hero-grid{grid-template-columns:1fr;min-height:auto;padding:55px 0 45px}
      .hero-art{height:270px}
      .trust-grid{grid-template-columns:repeat(3,1fr);padding:12px 0}
      .trust-label{grid-column:1/-1}
      .client:nth-of-type(n+7){display:none}
      .work-grid{grid-template-columns:repeat(2,1fr)}
      .services-grid{grid-template-columns:repeat(3,1fr)}
      .services-intro{grid-column:1/-1}
      .approach-grid{grid-template-columns:1fr}
      .experience-grid{grid-template-columns:repeat(2,1fr)}
      .experience-intro{grid-column:1/-1}
      .about-grid{grid-template-columns:145px 1fr}
      .about-grid .about-copy:last-child{grid-column:2}
      .contact-grid{grid-template-columns:1fr 1fr}
      .contact-actions{grid-column:1/-1;flex-direction:row}
    }

